# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files generated by BinaryProvider / BinDeps
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts from the Documenter package
docs/build/
docs/site/
docs/src/generated/

# Pkg manifest — not committed for packages
Manifest*.toml

# Preferences package local preferences
LocalPreferences.toml
JuliaLocalPreferences.toml

# macOS
.DS_Store

# throwaway spikes / prototypes
/scratch/

# superpowers working artifacts (local-only: design specs + implementation plans)
/.superpowers/

# internal research notes (kept local, not part of the public surface)
/docs/research/

# local planning specs / SDD ledger (not for public repo)
.superpowers/

# generated example plots (regenerated on docs/example runs)
*_trajectory*.png
*_coverage*.png
